@model Restaurant
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Title</title>

    <style>
       </style>
</head>
<body>
    <div class="container-custom">
        <!-- Кнопка Back -->
        <a asp-action="Index" class="back-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z" />
            </svg>
        </a>

        <!-- Блок із зображенням і текстом -->
        <div class="image-text-container">
            <!-- Зображення -->
            @if (Model.Photo != null)
            {
                <img src="@($"data:image/png;base64,{Convert.ToBase64String(Model.Photo)}")"
                     alt="Photo of @Model.Title" style="width: 450px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);" />
            }

            <!-- Текст -->
            <div class="text-content">
                <p>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" style="vertical-align: middle; margin-right: 5px;" viewBox="0 0 16 16">
                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 5v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V5H1z" />
                    </svg>
                    <strong>Графік роботи:</strong> @Model.WorkSchedule
                </p>
                <h3>Ресторан: @Model.Title</h3>
                <p>@Model.Description</p>
                @if (!string.IsNullOrEmpty(Model.FavoriteLinks))

                {
                    <p><strong>Меню:</strong> <a href="@Model.FavoriteLinks" target="_blank">Переглянути меню</a></p>
                }
                <p>📞 Reserve: <a href="tel:@Model.TelNum">@Model.TelNum</a></p>
                <p>📍 Location: @Model.Address</p>
                <hr>
            </div>
        </div>
    </div>
    <div style="height: 60px;"></div>
</body>
</html>
@section Styles {
    <link rel="stylesheet" href="~/css/restaurantdetails.css" />
}