
@{
    ViewData["Title"] = "Відгуки";

} <div>
    
    <h1 class="special-title-2 text-center"> @ViewData["Title"] </h1>
</div>

<div>

    <main class="about-main">
        <p class="text-body text-center" style="font-size: 24px;">
            Тут ви можете залишити свій відгук
        </p>
        <div class="row d-flex justify-content-center align-items-start vh-100" style="background-image: url('https://st3.depositphotos.com/3562663/16608/i/450/depositphotos_166087924-stock-photo-blurred-restaurant-cafe.jpg'); background-size: cover; background-position: center top;">
            <div class="col-md-7 contact-form" style="background-color: rgba(0, 0, 0, 0.7); padding: 30px; border-radius: 20px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); margin-top: 40px;">
                <form>
                    <div class="form-row">
                        <div class="form-group col-md-6" style="width: 30%">
                            <label for="inputName" class="text-white">Ваше ім'я:</label>
                            <input type="text" class="form-control" id="inputName" placeholder="Петро Петрович">
                        </div>
                        <div class="form-group col-md-6" style="width: 30%">
                            <label for="inputName" class="text-white">Ресторан якому ви хочите написати відгук:</label>
                            <input type="text" class="form-control" id="inputName" placeholder="Мацурі">
                        </div>
                        <div class="form-group col-md-6" style="width: 30%">
                            <label for="inputEmail" class="text-white">Пошта Адміністрації (name@example.com):</label>
                            <input type="email" class="form-control" id="inputEmail" placeholder="name@example.com">
                        </div>
                    </div>
                    <div class="form-group" style="width: 70%">
                        <label for="inputTextarea" class="text-white">Повідомлення:</label>
                        <textarea class="form-control" id="inputTextarea" rows="7" placeholder="Додаткова інформація"></textarea>
                    </div>

                    <!-- Зірочки для рейтингу -->
                    <div class="form-group">
                        <label for="rating" class="text-white">Рейтинг:</label>
                        <div id="rating" class="stars">
                            <span class="star" data-value="1">&#9733;</span>
                            <span class="star" data-value="2">&#9733;</span>
                            <span class="star" data-value="3">&#9733;</span>
                            <span class="star" data-value="4">&#9733;</span>
                            <span class="star" data-value="5">&#9733;</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-light" style="margin-top: 20px;">Відправити</button>
                </form>
            </div>
        </div>
    </main>
    
    <script>
        const stars = document.querySelectorAll('.star');
        stars.forEach(star => {
            star.addEventListener('click', () => {
                let rating = star.getAttribute('data-value');
                stars.forEach(s => s.classList.remove('selected'));
                for (let i = 0; i < rating; i++) {
                    stars[i].classList.add('selected');
                }
            });
        });
    </script>

</div>
@section Styles {
    <link rel="stylesheet" href="~/css/reviews.css" />
}

