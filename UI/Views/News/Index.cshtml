@model List<News>
<h1>@ViewData["Title"]</h1>
<main>
    
    <!-- ALBUM DESCRIPTION -->
    <div class="album-description container-fluid text-white" style="background-color: #4682B4;">
        <h1 class="title-3">NEWS</h1>
        <h2 class="title-3">SPECIALS &amp; EVENTS</h2>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="text-right mb-3">
            <a asp-controller="News" asp-action="Create" class="btn btn-success">Добавити новину</a>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
    
    <div class="album-content">
        <div class="container">
            <div class="row">
                @foreach (var news in Model)
                {
                    <div id="card-food" class="col-md-4">
                        <div class="card box-shadow">
                            <img class="card-img-top" src="data:image/jpeg;base64,@Convert.ToBase64String(news.Photo)" alt="@news.Title" />
                            <div class="card-body">
                                <h5 class="card-title font-weight-bold"> @news.Title </h5>
                                <p class="card-text">
                                    @news.ShortDescription
                                </p>
                                <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id" class="btn btn-outline-dark" role="button">View</a>
                                @if (TempData["ErrorMessage"] != null)

                                {
                                    <div class="alert alert-danger">
                                        @TempData["ErrorMessage"]
                                    </div>
                                }

                                @if (User.IsInRole("Admin"))

                                {
                                    <!-- Посилання на редагування (лише для Admin) -->
                                    <a asp-controller="News" asp-action="Edit" asp-route-id="@news.Id" class="btn btn-warning" role="button">Edit</a>

                                    <!-- Кнопка видалення (лише для Admin) -->
                                    <form asp-controller="News" asp-action="Delete" asp-route-id="@news.Id" method="post" onsubmit="return confirm('Ви впевнені, що хочете видалити цю новину?');" style="display:inline;">
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
               
            </div>
        </div>
    </div>
</main>
@section Styles {
    <link rel="stylesheet" href="~/css/news.css" />
}

